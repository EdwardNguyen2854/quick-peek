# Copy to backend/.env or set as environment variables.
QUICKPEEK_SECRET_KEY=change-this-to-a-long-random-value
QUICKPEEK_DB_PATH=./data/quickpeek.sqlite3
QUICKPEEK_FILE_ROOTS=./data/files
QUICKPEEK_ADMIN_USERNAME=admin
QUICKPEEK_ADMIN_PASSWORD=admin123
QUICKPEEK_ACCESS_TOKEN_EXPIRE_MINUTES=720
QUICKPEEK_MANUAL_SECONDS_PER_FILE=45
QUICKPEEK_APP_SECONDS_PER_FILE=8

# Optional STEP conversion. Command must create the output GLB file.
# Use {input} and {output} placeholders.
# Example idea: QUICKPEEK_STEP_CONVERTER_CMD="C:\\Tools\\step-to-glb.exe" "{input}" "{output}"
QUICKPEEK_STEP_CONVERTER_CMD=
