# Copy to backend/.env or set as environment variables.
QUICKPEEK_DB_PATH=./data/quickpeek.sqlite3
QUICKPEEK_FILE_ROOTS=./data/files
QUICKPEEK_MAX_CONVERT_SIZE_MB=100

# Optional STEP conversion. Command must tessellate STEP and create the output GLB file.
# Use {input} and {output} placeholders.
# Example: QUICKPEEK_STEP_CONVERTER_CMD="C:\\Tools\\step-to-glb.exe" "{input}" "{output}"
QUICKPEEK_STEP_CONVERTER_CMD=

# Optional LibreOffice command for Office-document conversion.
QUICKPEEK_LIBREOFFICE_CMD=
